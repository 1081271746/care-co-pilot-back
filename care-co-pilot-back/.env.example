# Copia este archivo como .env. No contiene credenciales.
APP_NAME=Co-Piloto de Duelo
APP_ENV=development
# Orígenes exactos de Angular, separados por comas. Nunca utilizar "*".
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Genera un secreto aleatorio de al menos 32 bytes y configúralo en el entorno seguro.
JWT_SECRET_KEY=
## OpenAI con tu propia cuenta. Nunca subir la clave ni el archivo .env.
OPENAI_API_KEY=
OPENAI_ANALYSIS_ENABLED=false
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=25
# Configúrala solo si vas a usar una conexión PostgreSQL.
DATABASE_URL=
# Solo integración: base local dedicada cuyo nombre termine en _test.
# Configura la URL real en variables seguras, nunca en archivos versionados.
TEST_DATABASE_URL=
# Cambiar a 1, junto con APP_ENV=test, solo al ejecutar integración.
TEST_POSTGRES_ALLOW_MIGRATIONS=0
